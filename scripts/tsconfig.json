{
  // Node-side scripts: bike generator + GLB inspector. Checked by `npm run typecheck`.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    // shopify-csv.ts reuses the app's catalog modules, which import via "~/…".
    "paths": { "~/*": ["../app/*"] }
  },
  "include": ["./**/*.ts", "../app/utils/three/inspectModel.ts", "../app/utils/three/assetMapping.ts", "../app/config/assetMap.ts"]
}
